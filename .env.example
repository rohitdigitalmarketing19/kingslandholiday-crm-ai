# Server Port
PORT=5000

# Database Persistence Configuration (CRITICAL for Server Updates)
# On VPS/Linux: Set to a persistent file location so updates never erase your data
# Example: DATABASE_PATH=/var/data/kingsland.db or DATABASE_PATH=./kingsland.db
DATABASE_PATH=kingsland.db

# Optional Custom Backup Path (Defaults to "backups" folder next to your database)
# BACKUP_PATH=/var/data/backups

