# Server Configuration
PORT=5000

# Persistent Database Storage (CRITICAL FOR CLOUD / VPS DEPLOYMENT)
# Set an absolute persistent path so your data is NEVER erased on server re-deploys:
# Example for Linux/VPS/Ubuntu: DATABASE_PATH=/var/data/kingsland.db
# Example for Docker/Render Persistent Disk: DATABASE_PATH=/data/kingsland.db
DATABASE_PATH=kingsland.db

# Optional Custom Backup Path (Defaults to same folder as database)
# BACKUP_PATH=/var/data/backups

# SMTP Email Configuration for Admin Security OTP & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rohit.digitalmarketing19@gmail.com
SMTP_PASS=vrsa reev ziev otqa  # Generate 16-digit App Password from https://myaccount.google.com/apppasswords

# Optional Fallback Keys
EMAIL_USER=rohit.digitalmarketing19@gmail.com
